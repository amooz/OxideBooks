{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "name": "OxideBooks Design Tokens",
    "version": "1.0.0"
  },

  "palette": {
    "$description": "Raw color values. Use semantic tokens in components.",
    "teal": {
      "50":  { "$value": "#F0FDFA", "$type": "color" },
      "100": { "$value": "#CCFBF1", "$type": "color" },
      "200": { "$value": "#99F6E4", "$type": "color" },
      "300": { "$value": "#5EEAD4", "$type": "color" },
      "400": { "$value": "#2DD4BF", "$type": "color" },
      "500": { "$value": "#14B8A6", "$type": "color" },
      "600": { "$value": "#0D9488", "$type": "color" },
      "700": { "$value": "#0F766E", "$type": "color" },
      "800": { "$value": "#115E59", "$type": "color" },
      "900": { "$value": "#134E4A", "$type": "color" },
      "950": { "$value": "#042F2E", "$type": "color" }
    },
    "zinc": {
      "50":  { "$value": "#FAFAFA", "$type": "color" },
      "100": { "$value": "#F4F4F5", "$type": "color" },
      "200": { "$value": "#E4E4E7", "$type": "color" },
      "300": { "$value": "#D4D4D8", "$type": "color" },
      "400": { "$value": "#A1A1AA", "$type": "color" },
      "500": { "$value": "#71717A", "$type": "color" },
      "600": { "$value": "#52525B", "$type": "color" },
      "700": { "$value": "#3F3F46", "$type": "color" },
      "800": { "$value": "#27272A", "$type": "color" },
      "900": { "$value": "#18181B", "$type": "color" },
      "950": { "$value": "#09090B", "$type": "color" }
    },
    "stone": {
      "50":  { "$value": "#FAFAF9", "$type": "color" },
      "100": { "$value": "#F5F5F4", "$type": "color" },
      "200": { "$value": "#E7E5E4", "$type": "color" },
      "300": { "$value": "#D6D3D1", "$type": "color" },
      "400": { "$value": "#A8A29E", "$type": "color" },
      "500": { "$value": "#78716C", "$type": "color" },
      "600": { "$value": "#57534E", "$type": "color" },
      "700": { "$value": "#44403C", "$type": "color" },
      "800": { "$value": "#292524", "$type": "color" },
      "900": { "$value": "#1C1917", "$type": "color" },
      "950": { "$value": "#0C0A09", "$type": "color" }
    },
    "green": {
      "50":  { "$value": "#F0FDF4", "$type": "color" },
      "100": { "$value": "#DCFCE7", "$type": "color" },
      "400": { "$value": "#4ADE80", "$type": "color" },
      "500": { "$value": "#22C55E", "$type": "color" },
      "600": { "$value": "#16A34A", "$type": "color" },
      "700": { "$value": "#15803D", "$type": "color" },
      "950": { "$value": "#052E16", "$type": "color" }
    },
    "red": {
      "50":  { "$value": "#FEF2F2", "$type": "color" },
      "100": { "$value": "#FEE2E2", "$type": "color" },
      "400": { "$value": "#F87171", "$type": "color" },
      "500": { "$value": "#EF4444", "$type": "color" },
      "600": { "$value": "#DC2626", "$type": "color" },
      "700": { "$value": "#B91C1C", "$type": "color" },
      "950": { "$value": "#450A0A", "$type": "color" }
    },
    "amber": {
      "50":  { "$value": "#FFFBEB", "$type": "color" },
      "100": { "$value": "#FEF3C7", "$type": "color" },
      "300": { "$value": "#FCD34D", "$type": "color" },
      "400": { "$value": "#FBBF24", "$type": "color" },
      "500": { "$value": "#F59E0B", "$type": "color" },
      "600": { "$value": "#D97706", "$type": "color" },
      "950": { "$value": "#451A03", "$type": "color" }
    },
    "indigo": {
      "50":  { "$value": "#EEF2FF", "$type": "color" },
      "100": { "$value": "#E0E7FF", "$type": "color" },
      "400": { "$value": "#818CF8", "$type": "color" },
      "500": { "$value": "#6366F1", "$type": "color" },
      "600": { "$value": "#4F46E5", "$type": "color" },
      "950": { "$value": "#1E1B4B", "$type": "color" }
    }
  },

  "color": {
    "$description": "Semantic tokens. Two values per token: light and dark.",

    "bg":        { "light": "#FFFFFF",   "dark": "#09090B" },
    "surface":   { "light": "#FAFAF9",   "dark": "#18181B" },
    "surface-2": { "light": "#F5F5F4",   "dark": "#27272A" },
    "surface-3": { "light": "#E7E5E4",   "dark": "#3F3F46" },

    "border":       { "light": "#E7E5E4", "dark": "#3F3F46" },
    "border-2":     { "light": "#D6D3D1", "dark": "#52525B" },
    "border-focus": { "light": "#0F766E", "dark": "#2DD4BF" },

    "text-1":       { "light": "#1C1917", "dark": "#FAFAFA" },
    "text-2":       { "light": "#57534E", "dark": "#A1A1AA" },
    "text-3":       { "light": "#A8A29E", "dark": "#71717A" },
    "text-inverse": { "light": "#FFFFFF", "dark": "#09090B" },

    "primary":          { "light": "#0F766E", "dark": "#2DD4BF" },
    "primary-hover":    { "light": "#0D9488", "dark": "#5EEAD4" },
    "primary-active":   { "light": "#115E59", "dark": "#14B8A6" },
    "primary-muted-bg": { "light": "#CCFBF1", "dark": "#042F2E" },
    "primary-text":     { "light": "#0F766E", "dark": "#2DD4BF" },

    "positive":          { "light": "#16A34A", "dark": "#4ADE80" },
    "positive-hover":    { "light": "#15803D", "dark": "#22C55E" },
    "positive-muted-bg": { "light": "#F0FDF4", "dark": "#052E16" },
    "positive-border":   { "light": "#DCFCE7", "dark": "#14532D" },

    "negative":          { "light": "#DC2626", "dark": "#F87171" },
    "negative-hover":    { "light": "#B91C1C", "dark": "#EF4444" },
    "negative-muted-bg": { "light": "#FEF2F2", "dark": "#450A0A" },
    "negative-border":   { "light": "#FEE2E2", "dark": "#7F1D1D" },

    "warning":          { "light": "#D97706", "dark": "#FCD34D" },
    "warning-hover":    { "light": "#F59E0B", "dark": "#FBBF24" },
    "warning-muted-bg": { "light": "#FFFBEB", "dark": "#451A03" },
    "warning-border":   { "light": "#FEF3C7", "dark": "#78350F" },

    "neutral-status":          { "light": "#6366F1", "dark": "#818CF8" },
    "neutral-status-muted-bg": { "light": "#EEF2FF", "dark": "#1E1B4B" },
    "neutral-status-border":   { "light": "#E0E7FF", "dark": "#312E81" }
  },

  "typography": {
    "fontFamily": {
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "sans-serif"],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["JetBrains Mono", "Fira Code", "ui-monospace", "monospace"],
        "$type": "fontFamily",
        "$description": "Used for all numeric and code values"
      }
    },
    "fontSize": {
      "xs":   { "$value": "0.75rem",  "$type": "dimension" },
      "sm":   { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem",     "$type": "dimension" },
      "lg":   { "$value": "1.125rem", "$type": "dimension" },
      "xl":   { "$value": "1.25rem",  "$type": "dimension" },
      "2xl":  { "$value": "1.5rem",   "$type": "dimension" },
      "3xl":  { "$value": "1.875rem", "$type": "dimension" },
      "4xl":  { "$value": "2.25rem",  "$type": "dimension" }
    },
    "fontWeight": {
      "normal":   { "$value": 400, "$type": "number" },
      "medium":   { "$value": 500, "$type": "number" },
      "semibold": { "$value": 600, "$type": "number" },
      "bold":     { "$value": 700, "$type": "number" }
    },
    "lineHeight": {
      "tight":   { "$value": 1.25  },
      "snug":    { "$value": 1.375 },
      "normal":  { "$value": 1.5   },
      "relaxed": { "$value": 1.625 }
    }
  },

  "spacing": {
    "0":    { "$value": "0",        "$type": "dimension" },
    "px":   { "$value": "1px",      "$type": "dimension" },
    "0.5":  { "$value": "0.125rem", "$type": "dimension" },
    "1":    { "$value": "0.25rem",  "$type": "dimension" },
    "1.5":  { "$value": "0.375rem", "$type": "dimension" },
    "2":    { "$value": "0.5rem",   "$type": "dimension" },
    "2.5":  { "$value": "0.625rem", "$type": "dimension" },
    "3":    { "$value": "0.75rem",  "$type": "dimension" },
    "4":    { "$value": "1rem",     "$type": "dimension" },
    "5":    { "$value": "1.25rem",  "$type": "dimension" },
    "6":    { "$value": "1.5rem",   "$type": "dimension" },
    "8":    { "$value": "2rem",     "$type": "dimension" },
    "10":   { "$value": "2.5rem",   "$type": "dimension" },
    "12":   { "$value": "3rem",     "$type": "dimension" },
    "16":   { "$value": "4rem",     "$type": "dimension" },
    "20":   { "$value": "5rem",     "$type": "dimension" },
    "24":   { "$value": "6rem",     "$type": "dimension" }
  },

  "borderRadius": {
    "sm":   { "$value": "0.25rem",  "$type": "dimension" },
    "base": { "$value": "0.375rem", "$type": "dimension" },
    "lg":   { "$value": "0.5rem",   "$type": "dimension" },
    "xl":   { "$value": "0.75rem",  "$type": "dimension" },
    "full": { "$value": "9999px",   "$type": "dimension" }
  },

  "duration": {
    "fast":  { "$value": "75ms",  "$type": "duration" },
    "base":  { "$value": "150ms", "$type": "duration" },
    "slow":  { "$value": "300ms", "$type": "duration" }
  }
}
