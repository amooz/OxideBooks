# Copy to .env and fill in real values before running
# docker compose up

# PostgreSQL password (used by both db and api services)
DB_PASSWORD=changeme

# JWT signing secret — generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-secret

# Port to expose the API on the host (default: 3000)
API_PORT=3000

# Set to false to disable public registration
REGISTRATION_OPEN=true
